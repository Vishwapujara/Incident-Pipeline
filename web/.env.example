# Optional. Where the server reads the snapshot built by `python -m src.export_snapshot`.
# Defaults to ../snapshot/dashboard.db when it exists (local dev), otherwise the
# snapshot is downloaded from DASHBOARD_DATA_URL (hosted).
# INCIDENTS_SNAPSHOT_PATH=../snapshot/dashboard.db
# DASHBOARD_DATA_URL=https://raw.githubusercontent.com/Vishwapujara/Incident-Pipeline/dashboard-data/dashboard.db
